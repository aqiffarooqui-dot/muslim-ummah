{
  "expo": {
    "name": "Muslim Ummah",
    "slug": "muslim-ummah",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "muslimummah",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "android": {
      "package": "com.aqiffarooqui.muslimummah",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.aqiffarooqui.muslimummah"
    },
    "plugins": [
      "expo-notifications"
    ]
  }
}
